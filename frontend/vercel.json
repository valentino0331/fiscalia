{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/", "destination": "/info/index.html" },
    { "source": "/info", "destination": "/info/index.html" },
    { "source": "/info/(.*)", "destination": "/info/$1" },
    { "source": "/landing", "destination": "/info/index.html" },
    { "source": "/landing/(.*)", "destination": "/info/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
